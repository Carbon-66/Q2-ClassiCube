+	y   = (float)Env.EdgeHeight + Borders_YOffset(block);
+	off = Borders_HorOffset(block);
+
+	v = (struct VertexTextured*)Gfx_LockDynamicVb(q2_seaVb, VERTEX_FORMAT_TEXTURED, q2_seaMax);
+	for (cz = 0; cz < chunksZ; cz++)
+	{
+		for (cx = 0; cx < chunksX; cx++)
