+		Gfx_DeleteDynamicVb(&q2_seaVb);
+		q2_seaMax = chunksX * chunksZ * 4;
+		q2_seaVb  = Gfx_CreateDynamicVb(VERTEX_FORMAT_TEXTURED, q2_seaMax);
+		if (!q2_seaVb) { q2_seaMax = 0; return; }
