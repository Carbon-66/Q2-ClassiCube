+	Gfx_SetupAlphaState(Blocks.Draw[block]);
+	Gfx_EnableMipmaps();
+	Gfx_BindTexture(edges_tex);
+	Gfx_SetVertexFormat(VERTEX_FORMAT_TEXTURED);
+	Gfx_BindDynamicVb(q2_seaVb);
+	Gfx_DrawVb_IndexedTris(quads * 4);
+	Gfx_DisableMipmaps();
+	Gfx_RestoreAlphaState(Blocks.Draw[block]);
+}
+#endif
