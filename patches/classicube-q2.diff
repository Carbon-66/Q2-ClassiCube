+			x1 = (float)(cx * CHUNK_SIZE); x2 = (float)min((cx + 1) * CHUNK_SIZE, World.Width);
+			z1 = (float)(cz * CHUNK_SIZE); z2 = (float)min((cz + 1) * CHUNK_SIZE, World.Length);
+			if (Frustum_TestBox(x1, y - 0.5f, z1, x2, y + 0.5f, z2, false) == FRUSTUM_OUTSIDE) continue;
+			u2 = x2 - x1; v2 = z2 - z1;
+			v->x = x1 + off; v->y = y; v->z = z1 + off; v->Col = color; v->U = 0;  v->V = 0;  v++;
+			v->x = x1 + off; v->y = y; v->z = z2 + off; v->Col = color; v->U = 0;  v->V = v2; v++;
+			v->x = x2 + off; v->y = y; v->z = z2 + off; v->Col = color; v->U = u2; v->V = v2; v++;
+			v->x = x2 + off; v->y = y; v->z = z1 + off; v->Col = color; v->U = u2; v->V = 0;  v++;
+			quads++;
+		}
+	}
+	Gfx_UnlockDynamicVb(q2_seaVb);
+	if (!quads) return;
