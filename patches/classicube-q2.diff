 static struct FrustumPlanes frustum;
 
+#ifdef CC_BUILD_Q2
+/* Whether the box could be in view: outside if wholly behind one plane (its corner farthest along
+ * the plane's normal is behind it). As Frustum_TestSphere, the near plane isn't tested. */
+static cc_bool Q2_BoxOutside(const struct Plane* p, float x1, float y1, float z1,
+							 float x2, float y2, float z2) {
+	float x = p->a >= 0 ? x2 : x1, y = p->b >= 0 ? y2 : y1, z = p->c >= 0 ? z2 : z1;
+	return p->a * x + p->b * y + p->c * z + p->d < 0;
+}
+
+/* far: the far plane too (MapRenderer's chunks); without, for what's drawn past it (EnvRenderer's
+ * stand-in sea, which is there because the chunks past it aren't) */
+int Frustum_TestBox(float x1, float y1, float z1, float x2, float y2, float z2, cc_bool far) {
+	if (Q2_BoxOutside(&frustum.L, x1, y1, z1, x2, y2, z2)) return FRUSTUM_OUTSIDE;
+	if (Q2_BoxOutside(&frustum.R, x1, y1, z1, x2, y2, z2)) return FRUSTUM_OUTSIDE;
+	if (Q2_BoxOutside(&frustum.B, x1, y1, z1, x2, y2, z2)) return FRUSTUM_OUTSIDE;
+	if (Q2_BoxOutside(&frustum.T, x1, y1, z1, x2, y2, z2)) return FRUSTUM_OUTSIDE;
+	if (far && Q2_BoxOutside(&frustum.F, x1, y1, z1, x2, y2, z2)) return FRUSTUM_OUTSIDE;
+	return FRUSTUM_ON_OR_IN;
+}
+#endif
