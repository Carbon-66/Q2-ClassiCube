+/* The box around the chunk's vertices (its faces, sprites and water), whole blocks from the chunk's
+ * corner (x1, y1, z1): occlusion culling tests it. The whole chunk's box reached up into the sky
+ * over ground that fills only its bottom, and its outline on the screen then took in the sky's
+ * tiles, where nothing is drawn to hide it: half the triangles drawn in the bench view were in
+ * chunks with no pixel left in the frame. */
+static void Q2_ChunkBounds(struct ChunkInfo* info, int x1, int y1, int z1, int count) {
+	float minX = 1e9f, minY = 1e9f, minZ = 1e9f, maxX = -1e9f, maxY = -1e9f, maxZ = -1e9f;
+	int i;
+	for (i = 0; i < count; i++)
+	{
+		const struct VertexTextured* v = &Builder_Vertices[i];
+		if (v->x < minX) minX = v->x; if (v->x > maxX) maxX = v->x;
+		if (v->y < minY) minY = v->y; if (v->y > maxY) maxY = v->y;
+		if (v->z < minZ) minZ = v->z; if (v->z > maxZ) maxZ = v->z;
+	}
+#define Q2_BOUND(v, lo, ceilIt) (cc_uint8)max(0, min(CHUNK_SIZE, (ceilIt) ? (int)Math_Ceil((v) - (lo)) : (int)Math_Floor((v) - (lo))))
+	info->q2MinX = Q2_BOUND(minX, x1, 0); info->q2MaxX = Q2_BOUND(maxX, x1, 1);
+	info->q2MinY = Q2_BOUND(minY, y1, 0); info->q2MaxY = Q2_BOUND(maxY, y1, 1);
+	info->q2MinZ = Q2_BOUND(minZ, z1, 0); info->q2MaxZ = Q2_BOUND(maxZ, z1, 1);
+#undef Q2_BOUND
+}
+#endif
